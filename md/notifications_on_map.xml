<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Notifications_On_Map" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>

    <cue name="Init" version="1">
      <actions>
        <include_actions ref="DefaultConfig" />
        <remove_value name="$config" />
      </actions>
    </cue>

    <!-- Reads (or initialises) mod config from player.entity.$notificationsOnMapConfig.
         Leaves a local $config reference; caller must <remove_value name="$config" />. -->
    <library name="DefaultConfig" purpose="include_actions" version="2">
      <actions>
        <do_if value="@player.entity.$notificationsOnMapConfig == null">
          <set_value name="player.entity.$notificationsOnMapConfig" exact="table[
            $showNotifications = false,
            $debugMode         = 'none',
            $switchViaContextMenu = false
          ]" />
        </do_if>
        <set_value name="$config" exact="player.entity.$notificationsOnMapConfig" />
        <!-- forward-compat: fill keys added in later versions -->
        <do_if value="$config.$showNotifications? == false">
          <set_value name="$config.$showNotifications" exact="false" />
        </do_if>
        <do_if value="$config.$debugMode? == false">
          <set_value name="$config.$debugMode" exact="'none'" />
        </do_if>
        <do_if value="$config.$switchViaContextMenu? == false">
          <set_value name="$config.$switchViaContextMenu" exact="false" />
        </do_if>
        <set_value name="$debugChance" exact="if $config.$debugMode != 'none' then 100 else 0" />
      </actions>
    </library>

    <!-- *** Options menu *** -->

    <cue name="Register_Menu" instantiate="true" version="1">
      <conditions>
        <event_cue_signalled cue="md.Simple_Menu_API.Reloaded" />
      </conditions>
      <actions>
        <signal_cue_instantly cue="md.Simple_Menu_API.Register_Options_Menu"
          param="table[
            $id      = 'notifications_on_map_options',
            $columns = 12,
            $title   = {1972092425, 1},
            $onOpen  = NotificationsOnMap_Options_Menu,
          ]" />
      </actions>
    </cue>

    <cue name="NotificationsOnMap_Options_Menu" instantiate="true" version="1">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <include_actions ref="DefaultConfig" />

        <!-- General section -->
        <run_actions ref="md.Options_Helper.Add_Title_Row">
          <param name="title" value="{1972092425, 10000}" />
          <param name="columns" value="12" />
        </run_actions>

        <run_actions ref="md.Options_Helper.Add_Checkbox">
          <param name="id" value="'showNotifications'" />
          <param name="col" value="1" />
          <param name="textColSpan" value="11" />
          <param name="text" value="{1972092425, 10010}" />
          <param name="data" value="$config" />
          <param name="handle" value="Handle_Checkbox_Changed" />
        </run_actions>

        <include_actions ref="md.Options_Helper.Add_Empty_Row" />

        <run_actions ref="md.Options_Helper.Add_Checkbox">
          <param name="id" value="'switchViaContextMenu'" />
          <param name="col" value="1" />
          <param name="textColSpan" value="11" />
          <param name="text" value="{1972092425, 10020}" />
          <param name="data" value="$config" />
          <param name="handle" value="Handle_Checkbox_Changed" />
        </run_actions>

        <include_actions ref="md.Options_Helper.Add_Empty_Row" />

        <!-- Debug section -->
        <run_actions ref="md.Options_Helper.Add_Title_Row">
          <param name="title" value="{1972092425, 90000}" />
          <param name="columns" value="12" />
        </run_actions>

        <set_value name="$debugOptions" exact="[
          table[$text = {1001, 34},          $value = 'none'],
          table[$text = {1972092425, 90012}, $value = 'debug'],
          table[$text = {1972092425, 90013}, $value = 'trace'],
        ]" />
        <set_value name="$currentIndex" exact="1" />
        <do_if value="$config.$debugMode == 'debug'">
          <set_value name="$currentIndex" exact="2" />
        </do_if>
        <do_elseif value="$config.$debugMode == 'trace'">
          <set_value name="$currentIndex" exact="3" />
        </do_elseif>
        <run_actions ref="md.Options_Helper.Add_Dropdown">
          <param name="id" value="'debugMode'" />
          <param name="options" value="$debugOptions" />
          <param name="currentIndex" value="$currentIndex" />
          <param name="col" value="1" />
          <param name="textColSpan" value="7" />
          <param name="text" value="{1972092425, 90010}" />
          <param name="dropdownColSpan" value="5" />
          <param name="handle" value="Handle_Dropdown_Changed" />
        </run_actions>
        <remove_value name="$debugOptions" />
        <remove_value name="$currentIndex" />
        <remove_value name="$config" />
      </actions>
    </cue>

    <cue name="Handle_Checkbox_Changed" instantiate="true" version="1">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <include_actions ref="DefaultConfig" />
        <set_value name="$resultTable" exact="$config" />
        <include_actions ref="md.Options_Helper.Process_Checkbox_Changed" />
        <remove_value name="$resultTable" />
        <raise_lua_event name="'NotificationsOnMap.ConfigChanged'" />
        <remove_value name="$config" />
      </actions>
    </cue>

    <cue name="Handle_Dropdown_Changed" instantiate="true" version="1">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <include_actions ref="DefaultConfig" />
        <set_value name="$resultTable" exact="$config" />
        <include_actions ref="md.Options_Helper.Process_Dropdown_Changed" />
        <remove_value name="$resultTable" />
        <raise_lua_event name="'NotificationsOnMap.ConfigChanged'" />
        <remove_value name="$config" />
      </actions>
    </cue>

  </cues>
</mdscript>